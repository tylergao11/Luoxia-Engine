++    "dialogue.finalizer.database_error",
++    "PostgreSQL rejected dialogue command finalization",
++    {
++      session_id: sessionId,
++      command_id: commandId,
++      postgres_code: error.code,
++      constraint,
++      postgres_message:
++        typeof error.message === "string" ? error.message : "",
++    },
++  );
++}
